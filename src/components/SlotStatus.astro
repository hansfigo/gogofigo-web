---
import { commission } from '../config/site';
---

<p class:list={['slot', { open: commission.open }]}>
  <span class="dot" aria-hidden="true"></span>
  <span class="label slot-label">Commissions {commission.open ? 'open' : 'closed'}</span>
</p>

<style>
  .slot {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gray-4);
  }

  .open .dot {
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .open .slot-label {
    color: var(--accent);
  }
</style>
