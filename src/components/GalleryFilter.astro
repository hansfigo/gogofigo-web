---
const options = [
  { value: 'all', label: 'All' },
  { value: 'digital', label: 'Digital' },
  { value: 'acrylic', label: 'Acrylic' },
] as const;
---

<div class="filter" role="group" aria-label="Filter by medium" data-filter>
  {
    options.map((o, i) => (
      <button type="button" data-filter-value={o.value} aria-pressed={i === 0 ? 'true' : 'false'}>
        {o.label}
      </button>
    ))
  }
</div>

<style>
  .filter {
    display: flex;
    gap: var(--space-4);
  }

  button {
    min-height: 44px;
    font-size: var(--text-xs);
    color: var(--gray-5);
    transition: color var(--dur-fast) var(--ease-out);
  }

  button:hover,
  button[aria-pressed='true'] {
    color: var(--fg);
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  button::before {
    content: '';
    width: 5px;
    height: 5px;
    background: currentColor;
    transform: scale(0);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  button[aria-pressed='true']::before {
    transform: scale(1);
  }
</style>

<script>
  function initFilter() {
    const filter = document.querySelector<HTMLElement>('[data-filter]');
    if (!filter || filter.dataset.bound) return;
    filter.dataset.bound = 'true';

    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('[data-filter-value]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-work-grid] > [data-medium]')];

    filter.addEventListener('click', (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>('[data-filter-value]');
      if (!button) return;
      const value = button.dataset.filterValue!;
      for (const card of cards) card.hidden = value !== 'all' && card.dataset.medium !== value;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
    });
  }

  document.addEventListener('astro:page-load', initFilter);
</script>
