---
import WorkCard from './WorkCard.astro';
import type { Work } from '../lib/works';

interface Props {
  works: Work[];
  eagerCount?: number;
}

const { works, eagerCount = 0 } = Astro.props;
---

<!-- Loose editorial layout: works drift between columns with lots of air around them. -->
<ul class="work-grid" data-work-grid>
  {works.map((work, i) => <WorkCard work={work} eager={i < eagerCount} />)}
</ul>

<script>
  import '../scripts/reveal';
</script>

<style>
  .work-grid {
    display: grid;
    gap: var(--space-10) 0;
    padding: 0;
  }

  /* Phone: one column, widths and sides alternate. */
  .work-grid > :global(li:nth-child(4n + 2)) {
    width: 74%;
    justify-self: end;
  }

  .work-grid > :global(li:nth-child(4n + 3)) {
    width: 88%;
  }

  .work-grid > :global(li:nth-child(4n + 4)) {
    width: 80%;
    justify-self: center;
  }

  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-10) var(--space-6);
      align-items: start;
    }

    .work-grid > :global(li) {
      width: auto !important;
      justify-self: stretch !important;
    }

    .work-grid > :global(li:nth-child(6n + 1)) {
      grid-column: 1 / span 7;
    }

    .work-grid > :global(li:nth-child(6n + 2)) {
      grid-column: 9 / span 4;
      margin-top: 40%;
    }

    .work-grid > :global(li:nth-child(6n + 3)) {
      grid-column: 3 / span 4;
    }

    .work-grid > :global(li:nth-child(6n + 4)) {
      grid-column: 8 / span 5;
      margin-top: 25%;
    }

    .work-grid > :global(li:nth-child(6n + 5)) {
      grid-column: 2 / span 5;
      margin-top: 10%;
    }

    .work-grid > :global(li:nth-child(6n)) {
      grid-column: 7 / span 6;
    }
  }
</style>
