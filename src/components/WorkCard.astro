---
import WorkImage from './WorkImage.astro';
import { workUrl, type Work } from '../lib/works';

interface Props {
  work: Work;
  eager?: boolean;
}

const { work, eager = false } = Astro.props;
const { title, year, medium, image } = work.data;
// Landscape works get a wide row so they don't shrink into a narrow column.
const wide = image.width / image.height >= 1.25;
---

<li class:list={['work-card', { 'is-wide': wide }]} data-medium={medium}>
  <a href={workUrl(work)} class="work-link" data-lightbox-trigger={work.id}>
    <div class="work-frame" data-reveal-frame>
      <WorkImage work={work} sizes={wide ? '(min-width: 64rem) 75vw, 100vw' : '(min-width: 64rem) 55vw, 100vw'} eager={eager} />
    </div>
    <p class="work-caption">
      <span>{title}</span>
      <span class="year">{year}</span>
    </p>
  </a>
</li>

<style>
  .work-card {
    list-style: none;
  }

  .work-link {
    display: block;
    text-decoration: none;
  }

  .work-frame {
    position: relative;
    overflow: hidden;
  }

  .work-frame :global(.tile-cover) {
    position: absolute;
    inset: 0;
    display: grid;
  }

  .work-frame :global(.tile-cover i) {
    background: var(--bg);
    outline: 1px solid var(--bg); /* hide hairline seams between tiles */
  }

  .work-frame :global(img) {
    width: 100%;
    height: auto;
    transition: transform 1.2s var(--ease-out);
  }

  .work-caption {
    display: flex;
    gap: var(--space-3);
    padding-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--gray-5);
    overflow: hidden;
  }

  .year {
    font-family: var(--font-mono);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-caption > span {
      transform: translateY(110%);
      transition: transform var(--dur-base) var(--ease-out);
    }

    .work-caption .year {
      transition-delay: 40ms;
    }

    .work-link:hover .work-frame :global(img),
    .work-link:focus-visible .work-frame :global(img) {
      transform: scale(1.02);
    }

    .work-link:hover .work-caption > span,
    .work-link:focus-visible .work-caption > span {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-link:hover .work-frame :global(img) {
      transform: none;
    }
  }
</style>
