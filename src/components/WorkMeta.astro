---
import { mediumLabel, type Work } from '../lib/works';

interface Props {
  work: Work;
  class?: string;
}

const { work, class: className } = Astro.props;
const { year, medium, size } = work.data;
---

<p class:list={['label', 'work-meta', className]}>
  <span>{year}</span>
  <span aria-hidden="true">·</span>
  <span>{mediumLabel[medium]}</span>
  {
    size && (
      <>
        <span aria-hidden="true">·</span>
        <span>{size}</span>
      </>
    )
  }
</p>

<style>
  .work-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
  }
</style>
