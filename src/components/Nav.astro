---
import { nav, site, socials, commission } from '../config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/work') : path === href || path.startsWith(`${href}/`);
---

<!--
  Phone: a plain line of text at the top that scrolls away with the page.
  Desktop: a quiet fixed column on the left, like a gallery wall label.
-->
<header class="nav">
  <div class="top">
    <a href="/" class="wordmark" aria-label={`${site.name}, home`}>
      <span class="glyph" aria-hidden="true"><i></i><i></i><i></i></span>{site.name}
    </a>
    <p class="tagline">{site.tagline}</p>
  </div>

  <nav aria-label="Main">
    <ul class="links">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.href === '/commission' && commission.open && <span class="dot" aria-label="(open)" />}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="side-foot">
    <ul>
      {
        socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p>© {new Date().getFullYear()}</p>
  </div>
</header>

<style>
  .nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--nav-height);
    padding-inline: var(--gutter);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  /* Three stacked blocks: a tiny monolith as the mark. */
  .glyph {
    display: grid;
    grid-template-columns: repeat(2, 5px);
    grid-template-rows: repeat(2, 5px);
    gap: 1px;
  }

  .glyph i {
    background: currentColor;
  }

  .glyph i:first-child {
    grid-row: 1 / span 2;
  }

  .tagline,
  .side-foot {
    display: none;
  }

  .links {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  .links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    color: var(--gray-5);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--fg);
  }

  /* NieR-style cursor: a small square that slides in beside the current item. */
  .links a::before {
    content: '';
    position: absolute;
    left: -0.8rem;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
    background: currentColor;
    transform: scale(0);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .links a[aria-current='page']::before {
    transform: scale(1);
  }

  .dot {
    position: absolute;
    top: 0.85rem;
    right: -0.6rem;
    width: 5px;
    height: 5px;
    background: var(--accent);
  }

  @media (min-width: 64rem) {
    .nav {
      position: fixed;
      inset: 0 auto 0 0;
      width: var(--side-width);
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: var(--space-8);
      padding: var(--space-8) var(--space-6) var(--space-6) var(--gutter);
    }

    .tagline {
      display: block;
      margin-top: var(--space-1);
      font-size: var(--text-xs);
      color: var(--gray-5);
    }

    .links {
      flex-direction: column;
      gap: 0;
    }

    .links a {
      min-height: 0;
      padding-block: var(--space-1);
    }

    .dot {
      top: 0.55rem;
    }

    .links a:hover::before {
      transform: scale(1);
    }

    .side-foot {
      display: grid;
      gap: var(--space-3);
      margin-top: auto;
      font-size: var(--text-xs);
      color: var(--gray-5);
    }

    .side-foot ul {
      list-style: none;
      padding: 0;
    }

    .side-foot a {
      display: inline-block;
      padding-block: 2px;
      text-decoration: none;
    }

    .side-foot a:hover {
      color: var(--fg);
    }
  }
</style>
