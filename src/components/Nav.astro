---
import { nav, site, commission } from '../config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/work') : path === href || path.startsWith(`${href}/`);
---

<header class="nav">
  <div class="nav-inner container">
    <a href="/" class="wordmark" aria-label={`${site.name}, home`}>{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
                {item.href === '/commission' && commission.open && <span class="dot" aria-label="(open)" />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: var(--bg-translucent);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
  }

  .nav-inner {
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .wordmark {
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  a:not(.wordmark) {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    color: var(--gray-5);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  a:not(.wordmark):hover,
  a[aria-current='page'] {
    color: var(--fg);
  }

  .dot {
    position: absolute;
    top: 0.85rem;
    right: -0.55rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
