---
import { getImage } from 'astro:assets';
import { mediumLabel, workUrl, type Work } from '../lib/works';

interface Props {
  works: Work[];
}

const { works } = Astro.props;

// Pre-render image URLs for every work so the lightbox needs no extra requests to find them.
const items = await Promise.all(
  works.map(async (work) => {
    const { image, title, year, medium, size, alt } = work.data;
    const widths = [800, 1200, 1600, 2000].filter((w) => w <= image.width);
    const img = await getImage({
      src: image,
      widths: widths.length ? widths : [image.width],
      format: 'webp',
      quality: 82,
    });
    return {
      id: work.id,
      medium,
      title,
      alt,
      meta: [String(year), mediumLabel[medium], size].filter(Boolean).join(' · '),
      url: workUrl(work),
      src: img.src,
      srcset: img.srcSet.attribute,
      width: image.width,
      height: image.height,
    };
  }),
);
---

<dialog class="lightbox" aria-label="Artwork viewer" data-lightbox>
  <div class="lb-stage" data-lb-stage>
    <img class="lb-img" alt="" sizes="(min-width: 64rem) 80vw, 100vw" data-lb-img />
  </div>

  <div class="lb-bar">
    <div class="lb-caption" aria-live="polite">
      <p class="lb-title" data-lb-title></p>
      <p class="label" data-lb-meta></p>
    </div>
    <div class="lb-actions">
      <a class="lb-details" href="#" data-lb-link>View details</a>
      <span class="label lb-count" data-lb-count></span>
    </div>
  </div>

  <button type="button" class="lb-btn lb-prev" aria-label="Previous work" data-lb-prev>
    <span aria-hidden="true">←</span>
  </button>
  <button type="button" class="lb-btn lb-next" aria-label="Next work" data-lb-next>
    <span aria-hidden="true">→</span>
  </button>
  <button type="button" class="lb-btn lb-close" aria-label="Close" data-lb-close>
    <span aria-hidden="true">×</span>
  </button>

  <script type="application/json" data-lb-items set:html={JSON.stringify(items)} />
</dialog>

<style>
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--fg);
    overflow: hidden;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
  }

  .lightbox::backdrop {
    background: var(--bg);
  }

  .lb-stage {
    position: relative;
    min-height: 0;
    touch-action: pan-y;
    --pad-top: var(--space-8);
    --pad-x: var(--space-4);
    --pad-bottom: var(--space-4);
  }

  .lb-img {
    position: absolute;
    inset: var(--pad-top) var(--pad-x) var(--pad-bottom);
    margin: auto;
    width: auto;
    height: auto;
    max-width: calc(100% - var(--pad-x) * 2);
    max-height: calc(100% - var(--pad-top) - var(--pad-bottom));
    user-select: none;
    -webkit-user-drag: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .lb-img.is-loading {
    opacity: 0;
  }

  .lb-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--gutter) max(var(--space-5), env(safe-area-inset-bottom));
    border-top: 1px solid var(--hairline);
  }

  .lb-title {
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
  }

  .lb-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    flex-shrink: 0;
  }

  .lb-details {
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
    padding-block: var(--space-1);
  }

  .lb-details:hover {
    text-decoration: underline;
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    font-size: 1.25rem;
    color: var(--gray-5);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .lb-btn:hover {
    color: var(--fg);
    background: var(--gray-1);
  }

  .lb-close {
    top: var(--space-3);
    right: var(--space-3);
    font-size: 1.6rem;
  }

  /* On phones, swipe replaces the arrows. */
  .lb-prev,
  .lb-next {
    display: none;
  }

  @media (min-width: 48rem) {
    .lb-stage {
      --pad-x: var(--space-10);
      --pad-bottom: var(--space-5);
    }

    .lb-prev,
    .lb-next {
      display: grid;
      top: 50%;
      transform: translateY(-50%);
    }

    .lb-prev {
      left: var(--space-5);
    }

    .lb-next {
      right: var(--space-5);
    }
  }

  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }
</style>

<script>
  type Item = {
    id: string;
    medium: string;
    title: string;
    alt: string;
    meta: string;
    url: string;
    src: string;
    srcset: string;
    width: number;
    height: number;
  };

  let active: { dialog: HTMLDialogElement; open: (id: string, trigger: HTMLElement) => void } | null = null;

  // Registered once; the client router keeps module scripts alive across pages.
  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest<HTMLElement>('[data-lightbox-trigger]');
    if (!trigger || !active || !active.dialog.isConnected) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    e.preventDefault();
    active.open(trigger.dataset.lightboxTrigger!, trigger);
  }, { capture: true }); // Capture phase so this runs before the client router's link handler.

  function initLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = 'true';

    const items: Item[] = JSON.parse(dialog.querySelector('[data-lb-items]')?.textContent ?? '[]');
    const byId = new Map(items.map((item) => [item.id, item]));
    const q = <T extends Element>(sel: string) => dialog.querySelector<T>(sel)!;
    const img = q<HTMLImageElement>('[data-lb-img]');
    const title = q<HTMLElement>('[data-lb-title]');
    const meta = q<HTMLElement>('[data-lb-meta]');
    const link = q<HTMLAnchorElement>('[data-lb-link]');
    const count = q<HTMLElement>('[data-lb-count]');
    const stage = q<HTMLElement>('[data-lb-stage]');

    let sequence: string[] = [];
    let current = 0;
    let opener: HTMLElement | null = null;

    // Only cycle through works currently visible in the grid (respects the filter).
    const visibleIds = () =>
      [...document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]')]
        .filter((el) => !el.closest('[hidden]'))
        .map((el) => el.dataset.lightboxTrigger!);

    const show = (index: number) => {
      current = (index + sequence.length) % sequence.length;
      const item = byId.get(sequence[current]!);
      if (!item) return;
      img.classList.add('is-loading');
      img.onload = () => img.classList.remove('is-loading');
      img.width = item.width;
      img.height = item.height;
      img.srcset = item.srcset;
      img.src = item.src;
      img.alt = item.alt;
      title.textContent = item.title;
      meta.textContent = item.meta;
      link.href = item.url;
      count.textContent = `${current + 1} / ${sequence.length}`;
    };

    const open = (id: string, trigger: HTMLElement) => {
      sequence = visibleIds();
      opener = trigger;
      dialog.showModal();
      show(Math.max(0, sequence.indexOf(id)));
    };

    active = { dialog, open };

    q('[data-lb-prev]').addEventListener('click', () => show(current - 1));
    q('[data-lb-next]').addEventListener('click', () => show(current + 1));
    q('[data-lb-close]').addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Swipe left/right to navigate, swipe down to close.
    let startX = 0;
    let startY = 0;
    stage.addEventListener(
      'touchstart',
      (e) => {
        startX = e.touches[0]!.clientX;
        startY = e.touches[0]!.clientY;
      },
      { passive: true },
    );
    stage.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0]!.clientX - startX;
        const dy = e.changedTouches[0]!.clientY - startY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
        else if (dy > 80 && Math.abs(dy) > Math.abs(dx)) dialog.close();
      },
      { passive: true },
    );

    // Clicking the empty area around the image closes it.
    stage.addEventListener('click', (e) => {
      if (e.target === stage) dialog.close();
    });
  }

  document.addEventListener('astro:page-load', initLightbox);
</script>
