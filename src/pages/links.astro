---
import Base from '../layouts/Base.astro';
import { site, socials, commission } from '../config/site';
import { getEvents, formatEventDate } from '../lib/events';

const { upcoming } = await getEvents();
const nextEvent = upcoming[0];

const links = [
  { label: 'Work', detail: '', href: '/', external: false },
  {
    label: 'Commission',
    detail: commission.open ? 'Open' : 'Closed',
    href: '/commission',
    external: false,
  },
  ...(nextEvent
    ? [{ label: nextEvent.data.title, detail: formatEventDate(nextEvent), href: '/info#events', external: false }]
    : []),
  ...socials.map((s) => ({ label: s.label, detail: s.handle, href: s.href, external: true })),
  { label: 'Email', detail: site.email, href: `mailto:${site.email}`, external: false },
];
---

<Base title="Links" description="All gogofigo links in one place: gallery, commissions, events and socials.">
  <section class="links container">
    <h1 class="links-name">{site.name}</h1>

    <ul class="link-list">
      {
        links.map((l) => (
          <li>
            <a href={l.href} {...(l.external ? { target: '_blank', rel: 'me noopener' } : {})}>
              <span class="link-label">{l.label}</span>
              <span class="link-detail">
                {l.detail}
                {l.external && <span aria-hidden="true"> ↗</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .links {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    max-width: 32rem;
    padding-top: calc(var(--nav-height) + var(--space-8));
  }

  .links-name {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
  }

  .link-list {
    width: 100%;
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .link-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 48px;
    padding-block: var(--space-3);
    text-decoration: none;
  }

  .link-label {
    font-size: var(--text-base);
    font-weight: 500;
  }

  .link-list a:hover .link-label {
    color: var(--accent);
  }

  .link-detail {
    font-size: var(--text-xs);
    color: var(--gray-5);
    text-align: right;
    overflow-wrap: anywhere;
  }
</style>
