---
import Base from '../layouts/Base.astro';
import { bio, site, socials } from '../config/site';
import { getEvents, formatEventDate } from '../lib/events';

const { upcoming, past } = await getEvents();
---

<Base title="Info" description={bio.join(' ')} monolith="tower" seed={11}>
  <div class="info container">
    <h1 class="visually-hidden">Info</h1>
    <div class="bio">
      {bio.map((line) => <p>{line}</p>)}
    </div>

    <dl class="rows">
      <div class="row">
        <dt>Contact</dt>
        <dd>
          <ul>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            {
              socials.map((s) => (
                <li>
                  <a href={s.href} rel="me noopener" target="_blank">
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </dd>
      </div>

      <div class="row" id="events">
        <dt>Events</dt>
        <dd>
          <ul>
            {
              upcoming.map((e) => (
                <li class="upcoming">
                  <span class="now">Next</span> {e.data.title}
                  <span class="muted">
                    {formatEventDate(e)}, {e.data.location}
                    {e.data.booth && `, booth ${e.data.booth}`}
                  </span>
                </li>
              ))
            }
            {
              past.map((e) => (
                <li>
                  {e.data.title} <span class="muted">{formatEventDate(e)}</span>
                </li>
              ))
            }
            {upcoming.length + past.length === 0 && <li class="muted">Nothing scheduled.</li>}
          </ul>
        </dd>
      </div>
    </dl>
  </div>
</Base>

<style>
  .info {
    padding-top: calc(var(--nav-height) + var(--space-9));
  }

  .bio {
    max-width: 34rem;
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
    line-height: 1.3;
  }

  .bio p + p {
    color: var(--gray-5);
  }

  .rows {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-9);
    font-size: var(--text-sm);
  }

  .row {
    display: grid;
    gap: var(--space-2);
  }

  dt {
    font-size: var(--text-xs);
    color: var(--gray-5);
  }

  ul {
    display: grid;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .upcoming {
    display: grid;
  }

  .now {
    font-size: var(--text-xs);
    color: var(--accent);
    margin-right: var(--space-2);
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 10rem 1fr;
    }
  }
</style>
