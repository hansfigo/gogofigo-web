---
import Base from '../layouts/Base.astro';
import { getFeaturedWorks } from '../lib/works';

const [cover] = await getFeaturedWorks(1);
---

<Base
  title="About"
  description="About gogofigo: Figo, an illustrator and acrylic painter working in blues, indigos and flat brush strokes."
  image={cover?.data.image}
  imageAlt={cover?.data.alt}
>
  <section class="page-header container">
    <p class="label">About</p>
    <h1 class="page-title">Hi, I’m Figo.</h1>
  </section>

  <section class="container about">
    <!-- TODO: optional portrait or avatar. Add src/assets/avatar.jpg and render it here with <Image>. -->
    <div class="prose">
      <p class="lede">
        gogofigo is the name I paint under. I make digital illustrations in Clip Studio Paint and Procreate, and acrylic
        paintings on canvas.
      </p>
      <p>
        I’m drawn to fragile, intimate moments and to empty spaces that feel quiet and a little uncanny: a room after
        everyone has left, a corridor that goes on slightly too long. <!-- TODO: Figo to review this bio -->
      </p>
    </div>

    <dl class="facts">
      <div>
        <dt class="label">Style</dt>
        <dd>
          Anime proportions, painterly and decisive brushwork, graphic-first structure. Strokes like a flat or square
          brush.
        </dd>
      </div>
      <div>
        <dt class="label">Palette</dt>
        <dd>Blue, indigo and teal, with a lot of quiet space around them.</dd>
      </div>
      <div>
        <dt class="label">Process</dt>
        <!-- TODO: draft text, Figo to rewrite in their own words -->
        <dd>
          Digital work starts as small value thumbnails and is blocked in with large flat shapes before any detail.
          Paintings follow the same order in acrylic on stretched canvas.
        </dd>
      </div>
      <div>
        <dt class="label">Tools</dt>
        <dd>Clip Studio Paint, Procreate, acrylic on canvas.</dd>
      </div>
    </dl>

    <div class="about-links">
      <a href="/gallery" class="button button-secondary">See the work</a>
      <a href="/links" class="button button-secondary">Find me elsewhere</a>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    gap: var(--space-8);
  }

  .lede {
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .prose p:not(.lede) {
    color: var(--gray-5);
  }

  .facts {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .facts > div {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--hairline);
  }

  .facts dd {
    max-width: var(--measure);
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .facts > div {
      grid-template-columns: 10rem 1fr;
      gap: var(--space-6);
    }
  }
</style>
