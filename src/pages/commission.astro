---
import Base from '../layouts/Base.astro';
import { commission } from '../config/site';
---

<Base title="Commission" description="Commission an illustration from gogofigo through VGen." monolith="tower" seed={4}>
  <div class="commission container">
    <h1 class="status">
      Commissions <span class:list={{ open: commission.open }}>{commission.open ? 'open' : 'closed'}</span>
    </h1>

    <ul class="tiers">
      {
        commission.tiers.map((t) => (
          <li>
            <span>{t.name}</span>
            <span class="price">{t.priceFrom}</span>
          </li>
        ))
      }
    </ul>

    <a href={commission.vgenUrl} class="button" target="_blank" rel="noopener">
      {commission.open ? 'Request on VGen' : 'VGen'} <span aria-hidden="true">↗</span>
    </a>
  </div>
</Base>

<style>
  .commission {
    display: grid;
    justify-items: start;
    gap: var(--space-8);
    padding-top: calc(var(--nav-height) + var(--space-9));
  }

  .status {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
  }

  .status span {
    color: var(--gray-5);
  }

  .status .open {
    color: var(--accent);
  }

  .tiers {
    display: grid;
    gap: var(--space-2);
    width: 100%;
    max-width: 22rem;
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }

  .tiers li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .price {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--gray-5);
  }
</style>
