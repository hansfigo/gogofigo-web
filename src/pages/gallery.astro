---
import Base from '../layouts/Base.astro';
import GalleryFilter from '../components/GalleryFilter.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import { getWorks } from '../lib/works';

const works = await getWorks();
const cover = works[0];
---

<Base
  title="Gallery"
  description="All works by gogofigo: digital illustrations and acrylic paintings on canvas."
  image={cover?.data.image}
  imageAlt={cover?.data.alt}
>
  <section class="page-header container">
    <p class="label">Works · {works.length}</p>
    <h1 class="page-title">Gallery</h1>
    <div class="gallery-tools">
      <GalleryFilter />
    </div>
  </section>

  <section class="container" aria-label="Works">
    <WorkGrid works={works} eagerCount={1} />
    <p class="empty muted" hidden data-empty>No works in this category yet.</p>
  </section>

  <Lightbox works={works} />
</Base>

<style>
  .gallery-tools {
    margin-top: var(--space-6);
  }

  .empty {
    padding-block: var(--space-9);
  }
</style>

<script>
  function initFilter() {
    const filter = document.querySelector<HTMLElement>('[data-filter]');
    if (!filter || filter.dataset.bound) return;
    filter.dataset.bound = 'true';

    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('[data-filter-value]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-work-grid] > [data-medium]')];
    const empty = document.querySelector<HTMLElement>('[data-empty]');

    const apply = (value: string) => {
      let shown = 0;
      for (const card of cards) {
        const match = value === 'all' || card.dataset.medium === value;
        card.hidden = !match;
        if (match) shown++;
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filterValue === value));
      if (empty) empty.hidden = shown > 0;
    };

    filter.addEventListener('click', (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>('[data-filter-value]');
      if (button) apply(button.dataset.filterValue!);
    });
  }

  document.addEventListener('astro:page-load', initFilter);
</script>
