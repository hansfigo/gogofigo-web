---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkImage from '../../components/WorkImage.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getWorks, mediumLabel, workUrl, type Work } from '../../lib/works';

export const getStaticPaths = (async () => {
  const works = await getWorks();
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: {
      work,
      prev: works[(i - 1 + works.length) % works.length]!,
      next: works[(i + 1) % works.length]!,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  work: Work;
  prev: Work;
  next: Work;
}

const { work, prev, next } = Astro.props;
const { title, year, medium, size, description, image, alt, placeholder } = work.data;
const { Content } = await render(work);
const meta = [String(year), mediumLabel[medium], size].filter(Boolean).join(' · ');
---

<Base title={title} description={description ?? `${title} (${year}) by gogofigo.`} image={image} imageAlt={alt} type="article">
  <article class="work container">
    <figure class="figure">
      <WorkImage work={work} sizes="(min-width: 64rem) 70vw, 100vw" widths={[480, 800, 1200, 1600, 2000]} eager />
    </figure>
    <div class="info">
      <h1>{title}</h1>
      <p class="meta">{meta}</p>
      {description && <p class="desc">{description}</p>}
      <div class="body"><Content /></div>
      {placeholder && <Placeholder />}
    </div>
  </article>

  <nav class="pager container" aria-label="More works">
    <a href={workUrl(prev)}><span aria-hidden="true">←</span> {prev.data.title}</a>
    <a href={workUrl(next)}>{next.data.title} <span aria-hidden="true">→</span></a>
  </nav>
</Base>

<style>
  .work {
    display: grid;
    gap: var(--space-5);
    padding-top: calc(var(--nav-height) + var(--space-5));
  }

  .figure :global(img) {
    max-height: calc(100dvh - var(--nav-height) - var(--space-9));
    width: auto;
    height: auto;
  }

  .info {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    max-width: 30rem;
  }

  h1 {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--gray-5);
  }

  .desc {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--gray-5);
  }

  .body:empty {
    display: none;
  }

  .info :global(.placeholder-tag) {
    margin-top: var(--space-3);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-9);
    font-size: var(--text-xs);
  }

  .pager a {
    display: inline-block;
    padding-block: var(--space-3);
    color: var(--gray-5);
    text-decoration: none;
  }

  .pager a:hover {
    color: var(--fg);
  }

  @media (min-width: 64rem) {
    .work {
      grid-template-columns: minmax(0, 1fr) 16rem;
      align-items: end;
      gap: var(--space-8);
    }
  }
</style>
