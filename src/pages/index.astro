---
import Base from '../layouts/Base.astro';
import GalleryFilter from '../components/GalleryFilter.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../config/site';
import { getWorks } from '../lib/works';

const works = await getWorks();
const cover = works[0];
---

<Base image={cover?.data.image} imageAlt={cover?.data.alt} monolith="skyline">
  <h1 class="visually-hidden">{site.name}: {site.tagline}</h1>
  <div class="bar container">
    <p class="tagline">{site.tagline}</p>
    <GalleryFilter mediums={[...new Set(works.map((w) => w.data.medium))]} />
  </div>
  <section class="container" aria-label="Works">
    <WorkGrid works={works} eagerCount={1} />
  </section>
  <Lightbox works={works} />
</Base>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: calc(var(--nav-height) + var(--space-8));
    padding-bottom: var(--space-6);
  }

  .tagline {
    font-size: var(--text-xs);
    color: var(--gray-5);
  }

  @media (min-width: 64rem) {
    /* The side nav already carries the tagline. */
    .tagline {
      visibility: hidden;
    }
  }

  @media (min-width: 48rem) {
    .bar {
      padding-top: calc(var(--nav-height) + var(--space-8));
      padding-bottom: var(--space-8);
    }
  }
</style>
